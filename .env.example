# Base de datos (Supabase)
DATABASE_URL="postgresql://minera_app.slvsclofbtjugjhdijdx:Almd1564.ola@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.slvsclofbtjugjhdijdx:YPSS2314aarroo@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Seed (solo se usa al correr prisma:seed)
SEED_ADMIN_EMAIL="admin@empresa-ejemplo.pe"
SEED_ADMIN_PASSWORD="cambia-esto-minimo-12-caracteres"

# JWT — generar un secreto largo y aleatorio en producción (ej. openssl rand -base64 64)
JWT_SECRET="CAMBIAR_ESTE_VALOR_EN_PRODUCCION"

# Redis (cache + colas BullMQ)
REDIS_HOST="localhost"
REDIS_PORT="6379"

# CORS — dominios permitidos del frontend, separados por coma
CORS_ORIGINS="http://localhost:3001,https://app.minera-ejemplo.com"

# Cloudflare R2 (compatible con S3) — usado por StorageService para subir
# documentos/fotos y emitir URLs firmadas de corta duración.
STORAGE_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="CAMBIAR"
STORAGE_SECRET_ACCESS_KEY="CAMBIAR"
STORAGE_BUCKET="minera-documentos"
STORAGE_SIGNED_URL_EXPIRY_SECONDS="300"

PORT="3000"
