// ============================================================
// Prisma Schema - Sistema de Acreditación Minera
// Basado en el ERD de la Documentación Técnica Maestra v1.0
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS ----------

enum RolUsuario {
  SUPER_ADMIN
  RRHH
  OPERACIONES
  GERENCIA
  TRABAJADOR
}

enum EstadoSemaforo {
  VERDE
  AMARILLO
  ROJO
}

enum EstadoGeneralTrabajador {
  ACTIVO
  INACTIVO
  BLOQUEADO_TRANSPORTE
}

enum CategoriaDocumento {
  IDENTIDAD
  ANTECEDENTE
  MEDICO
  LICENCIA
  CURSO
}

enum RolEnFrente {
  LIDER
  AYUDANTE
}

enum TipoAsignacion {
  FIJO
  INTERMITENTE
}

enum EstadoFrenteTrabajo {
  PLANIFICADO
  ACTIVO
  CERRADO
}

// ---------- MODELOS ----------

model Empresa {
  id            String   @id @default(uuid())
  razonSocial   String   @map("razon_social")
  ruc           String   @unique
  createdAt     DateTime @default(now()) @map("created_at")

  trabajadores  Trabajador[]
  usuarios      Usuario[]
  mineras       EmpresaMinera[]

  @@map("empresa")
}

model Minera {
  id              String   @id @default(uuid())
  nombre          String   @unique
  colorPrimario   String?  @map("color_primario")
  colorSecundario String?  @map("color_secundario")
  logoUrl         String?  @map("logo_url")

  empresas            EmpresaMinera[]
  matrizRequisitos     MatrizRequisito[]
  frentesTrabajo       FrenteTrabajo[]
  convoyes             Convoy[]
  estadosContexto      TrabajadorEstadoContexto[]
  tema                 MineraTema?

  @@map("minera")
}

model MineraTema {
  id          String  @id @default(uuid())
  mineraId    String  @unique @map("minera_id")
  colorHex    String  @map("color_hex")
  tipografia  String?
  modo        String  @default("claro")

  minera Minera @relation(fields: [mineraId], references: [id])

  @@map("minera_tema")
}

model EmpresaMinera {
  id        String  @id @default(uuid())
  empresaId String  @map("empresa_id")
  mineraId  String  @map("minera_id")
  activo    Boolean @default(true)

  empresa Empresa @relation(fields: [empresaId], references: [id])
  minera  Minera  @relation(fields: [mineraId], references: [id])

  @@unique([empresaId, mineraId])
  @@map("empresa_minera")
}

model Trabajador {
  id               String                  @id @default(uuid())
  empresaId        String                  @map("empresa_id")
  nombres          String
  apellidos        String
  dni              String                  @unique
  fechaNacimiento  DateTime?               @map("fecha_nacimiento")
  fechaIngreso     DateTime                @map("fecha_ingreso")
  telefono         String?
  estadoGeneral    EstadoGeneralTrabajador @default(ACTIVO) @map("estado_general")
  createdAt        DateTime                @default(now()) @map("created_at")

  empresa           Empresa                     @relation(fields: [empresaId], references: [id])
  tags               TrabajadorTag[]
  documentos         Documento[]
  estadosContexto    TrabajadorEstadoContexto[]
  frenteMiembros     FrenteTrabajoMiembro[]
  convoyMiembros     ConvoyMiembro[]
  usuario            Usuario?

  @@index([apellidos])
  @@index([empresaId])
  @@map("trabajador")
}

model Tag {
  id        String  @id @default(uuid())
  nombre    String  @unique
  categoria String?

  trabajadores TrabajadorTag[]

  @@map("tag")
}

model TrabajadorTag {
  id           String   @id @default(uuid())
  trabajadorId String   @map("trabajador_id")
  tagId        String   @map("tag_id")
  esPrincipal  Boolean  @default(false) @map("es_principal")
  asignadoEn   DateTime @default(now()) @map("asignado_en")

  trabajador Trabajador @relation(fields: [trabajadorId], references: [id])
  tag        Tag        @relation(fields: [tagId], references: [id])

  @@unique([trabajadorId, tagId])
  @@index([tagId])
  @@map("trabajador_tag")
}

model Cargo {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String?

  matrizRequisitos MatrizRequisito[]
  estadosContexto  TrabajadorEstadoContexto[]

  @@map("cargo")
}

model DocumentoTipo {
  id                   String             @id @default(uuid())
  nombre               String
  categoria            CategoriaDocumento
  ventanaAlertaDias    Int                @default(30) @map("ventana_alerta_dias")
  requiereVencimiento  Boolean            @default(true) @map("requiere_vencimiento")

  matrizRequisitos MatrizRequisito[]
  documentos       Documento[]

  @@map("documento_tipo")
}

model MatrizRequisito {
  id                String    @id @default(uuid())
  mineraId          String    @map("minera_id")
  cargoId           String    @map("cargo_id")
  documentoTipoId   String    @map("documento_tipo_id")
  obligatorio       Boolean   @default(true)
  version           Int       @default(1)
  vigenteDesde      DateTime  @map("vigente_desde")
  vigenteHasta      DateTime? @map("vigente_hasta")

  minera        Minera        @relation(fields: [mineraId], references: [id])
  cargo         Cargo         @relation(fields: [cargoId], references: [id])
  documentoTipo DocumentoTipo @relation(fields: [documentoTipoId], references: [id])

  @@unique([mineraId, cargoId, documentoTipoId, version])
  @@index([mineraId, cargoId])
  @@map("matriz_requisito")
}

model Documento {
  id                String         @id @default(uuid())
  trabajadorId      String         @map("trabajador_id")
  documentoTipoId   String         @map("documento_tipo_id")
  archivoUrl        String         @map("archivo_url")
  archivoHash        String?        @map("archivo_hash")
  fechaEmision      DateTime?      @map("fecha_emision")
  fechaVencimiento  DateTime?      @map("fecha_vencimiento")
  estadoSemaforo    EstadoSemaforo @default(ROJO) @map("estado_semaforo")
  subidoPor         String?        @map("subido_por")
  createdAt         DateTime       @default(now()) @map("created_at")

  trabajador    Trabajador    @relation(fields: [trabajadorId], references: [id])
  documentoTipo DocumentoTipo @relation(fields: [documentoTipoId], references: [id])

  @@index([trabajadorId])
  @@index([fechaVencimiento])
  @@index([estadoSemaforo])
  @@map("documento")
}

model TrabajadorEstadoContexto {
  id                 String    @id @default(uuid())
  trabajadorId       String    @map("trabajador_id")
  mineraId           String    @map("minera_id")
  cargoId            String    @map("cargo_id")
  porcentajeAvance   Decimal   @default(0) @map("porcentaje_avance") @db.Decimal(5, 2)
  es100Porciento     Boolean   @default(false) @map("es_100_porciento")
  fechaAlcanzo100    DateTime? @map("fecha_alcanzo_100")
  calculadoEn        DateTime  @default(now()) @map("calculado_en")

  trabajador Trabajador @relation(fields: [trabajadorId], references: [id])
  minera     Minera     @relation(fields: [mineraId], references: [id])
  cargo      Cargo      @relation(fields: [cargoId], references: [id])

  @@unique([trabajadorId, mineraId, cargoId])
  @@map("trabajador_estado_contexto")
}

model FrenteTrabajo {
  id          String              @id @default(uuid())
  mineraId    String              @map("minera_id")
  nombre      String
  fechaInicio DateTime            @map("fecha_inicio")
  fechaFin    DateTime?           @map("fecha_fin")
  estado      EstadoFrenteTrabajo @default(PLANIFICADO)

  minera   Minera                 @relation(fields: [mineraId], references: [id])
  miembros FrenteTrabajoMiembro[]

  @@map("frente_trabajo")
}

model FrenteTrabajoMiembro {
  id              String         @id @default(uuid())
  frenteTrabajoId String         @map("frente_trabajo_id")
  trabajadorId    String         @map("trabajador_id")
  rolEnFrente     RolEnFrente    @map("rol_en_frente")
  tipoAsignacion  TipoAsignacion @map("tipo_asignacion")
  fueOverride     Boolean        @default(false) @map("fue_override")
  overridePor     String?        @map("override_por")
  overrideMotivo  String?        @map("override_motivo")
  asignadoEn      DateTime       @default(now()) @map("asignado_en")

  frenteTrabajo FrenteTrabajo @relation(fields: [frenteTrabajoId], references: [id])
  trabajador    Trabajador    @relation(fields: [trabajadorId], references: [id])

  @@index([frenteTrabajoId])
  @@index([trabajadorId])
  @@map("frente_trabajo_miembro")
}

model Convoy {
  id       String  @id @default(uuid())
  codigo   String  @unique
  mineraId String  @map("minera_id")
  estado   String  @default("ACTIVO")

  minera   Minera          @relation(fields: [mineraId], references: [id])
  miembros ConvoyMiembro[]

  @@map("convoy")
}

model ConvoyMiembro {
  id           String   @id @default(uuid())
  convoyId     String   @map("convoy_id")
  trabajadorId String   @map("trabajador_id")
  asignadoEn   DateTime @default(now()) @map("asignado_en")

  convoy     Convoy     @relation(fields: [convoyId], references: [id])
  trabajador Trabajador @relation(fields: [trabajadorId], references: [id])

  @@map("convoy_miembro")
}

model Usuario {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String     @map("password_hash")
  rol           RolUsuario
  empresaId     String?    @map("empresa_id")
  trabajadorId  String?    @unique @map("trabajador_id")
  activo        Boolean    @default(true)

  empresa    Empresa?    @relation(fields: [empresaId], references: [id])
  trabajador Trabajador? @relation(fields: [trabajadorId], references: [id])

  @@map("usuario")
}

model AuditoriaLog {
  id         String   @id @default(uuid())
  usuarioId  String?  @map("usuario_id")
  accion     String
  entidad    String
  entidadId  String?  @map("entidad_id")
  detalle    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entidad, entidadId])
  @@index([createdAt])
  @@map("auditoria_log")
}
